! =============================================================================
! linac middle klystron overlays
! a bit less fancy than the LCLS equivalents, but good enough for now... (?)
! =============================================================================

! constants for klystron power split
! kps4 = 1/4 is the nominal 25% for a 4-structure klystron
! kps3a/b are for when there are only 3 structures
! one gets kps3a, theee other two receive kps3b
kps4  = 0.25
kps3a = 0.4142135623730951
kps3b = 0.2928932188134525


! =============================================================================
! L1F
! =============================================================================

O_K11_1: overlay = {
    K11_1B[phi0]:phase_deg/360, K11_1B[voltage]:ENLD_MEV*1e6*kps3a,
    K11_1C[phi0]:phase_deg/360, K11_1C[voltage]:ENLD_MEV*1e6*kps3b,
    K11_1D[phi0]:phase_deg/360, K11_1D[voltage]:ENLD_MEV*1e6*kps3b,
    }, var = {phase_deg, ENLD_MEV}

O_K11_2: overlay = {
    K11_2A[phi0]:phase_deg/360, K11_2A[voltage]:ENLD_MEV*1e6*kps3a,
    K11_2B[phi0]:phase_deg/360, K11_2B[voltage]:ENLD_MEV*1e6*kps3b,
    K11_2C[phi0]:phase_deg/360, K11_2C[voltage]:ENLD_MEV*1e6*kps3b,
    }, 
    var = {phase_deg, ENLD_MEV}

! =============================================================================
! L2F
! note no 14-7 or 8
